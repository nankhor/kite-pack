{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kite Pack",
  "identifier": "com.vesperstudio.kitepack",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Kite Pack",
        "width": 1180,
        "height": 780,
        "minWidth": 860,
        "minHeight": 620,
        "backgroundColor": "#121417",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "appimage"],
    "category": "Utility",
    "shortDescription": "Pack PS5 games with zstd",
    "copyright": "GPL-3.0-or-later",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
